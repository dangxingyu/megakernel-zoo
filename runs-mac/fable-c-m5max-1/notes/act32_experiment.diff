+# Activations between kernels: float32 (MK_ACT32=1, default) or IEEE half bits in uint16 buffers (MK_ACT32=0). The
+# kernel sources below are written for half; with float32 the loads, stores and pointer types are rewritten here.
+ACT32 = os.environ.get("MK_ACT32", "1") == "1"
+ADT = mx.float32 if ACT32 else mx.uint16
+
+
+def _act32(src: str) -> str:
+    src = src.replace("(const device half4*)", "(const device float4*)").replace("(device half4*)", "(device float4*)")
+    src = re.sub(r"\bhalf4\b", "float4", src)
+    src = re.sub(r"const device ushort\* (xr\d*|xq|xp|kp|vp)\b", r"const device float* \1", src)
+    src = src.replace("return as_type<ushort>(half(f));", "return f;").replace("inline ushort to_bf16(float f)", "inline float to_bf16(float f)")
+    return src
+
+
+def _metal_kernel(name, input_names, output_names, source, header=""):
+    if ACT32:
+        source, header = _act32(source), _act32(header)
+    return mx.fast.metal_kernel(name=name, input_names=input_names, output_names=output_names, source=source, header=header)
+
+
+
